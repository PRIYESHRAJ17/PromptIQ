# ============================================================
# PromptIQ Configuration
# ============================================================

# Environment: development, staging, production, test
PROMPTIQ_ENV=development
PROMPTIQ_LOG_LEVEL=INFO

# Backend API Configuration
PROMPTIQ_API_HOST=0.0.0.0
PROMPTIQ_API_PORT=8000
PROMPTIQ_SECRET_KEY=change_this_to_a_secure_random_string_in_production
PROMPTIQ_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Default is SQLite for zero-configuration development and automated testing
# In production, set to PostgreSQL e.g.: postgresql+asyncpg://user:pass@localhost:5432/promptiq
DATABASE_URL=sqlite+aiosqlite:///./promptiq.db

# Storage Configuration
STORAGE_LOCAL_DIR=./storage

# ============================================================
# Centrally Managed Zero-Price Inference Gateway
# Note: Operator-level server-side credentials only.
# End users NEVER supply API keys. BYOK is strictly prohibited.
# ============================================================
# Provider selection: mock (deterministic test), gemini, groq, openrouter
MANAGED_INFERENCE_PRIMARY_ROUTE=mock
MANAGED_INFERENCE_ALLOW_MOCK_FALLBACK=true

# Operator credentials (Optional for live hosted modes, left blank for mock)
OPERATOR_GEMINI_API_KEY=
OPERATOR_GROQ_API_KEY=
OPERATOR_OPENROUTER_API_KEY=

# Capacity Governor Limits
RATE_LIMIT_USER_REQUESTS_PER_HOUR=60
RATE_LIMIT_GLOBAL_CONCURRENCY=10

# Telegram Bot Configuration (Optional for Telegram surface)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
